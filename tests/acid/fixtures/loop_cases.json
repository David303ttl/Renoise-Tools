  "semantics": "cycle_reset_v1",
  "cycles": 3,
  "index_base": 1,
  "note_numbering": "Renoise note_value, 0..119",
  "capacity": 64,
  "normalization": "Pad supplied pitches to capacity with valid C defaults; preserve explicit pitch_length. All fixtures start silent. Reset next-consumed PITCH to P01 each TIME cycle; retain voice identity independently.",
  "expectation_order": "Each note_* array follows NOTE commands in TIME order. tie_notes follows TIE commands, null means silent. rest_releases follows REST commands. expected has exactly one record per cycle.",
  "boundary_family": {
    "id": "page_boundaries_and_acceptance_lengths",
    "source_generator": {
      "pitch_length": 64,
      "pitch_indices": "1..64 inclusive",
      "note_formula": "note = 24 + pitch_index",
      "slide_pitch_indices": [15, 30, 45, 60],
      "time_default": "N",
      "time_overrides": {"16": "T", "32": "R", "48": "T", "64": "T"},
      "length_rule": "For each length_case use exactly the first length TIME commands; retain all 64 PITCH entries. Start silent and run three cycles."
    },
    "expected_checkpoint_each_cycle": [
      {"step": 16, "kind": "tie", "voice_pitch_index": 15, "voice_note": 39, "holds": true, "hold_intent": true},
