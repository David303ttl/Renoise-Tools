      {"length": 33, "note_count": 31, "first_transitions": ["attack", "retrigger", "retrigger"], "exit_voice": {"note": 55, "pitch_index": 31, "slide": false}, "exit_next_pitch": 32},
      {"length": 48, "note_count": 45, "first_transitions": ["attack", "slide", "slide"], "exit_voice": {"note": 69, "pitch_index": 45, "slide": true}, "exit_next_pitch": 46},
      {"length": 49, "note_count": 46, "first_transitions": ["attack", "retrigger", "retrigger"], "exit_voice": {"note": 70, "pitch_index": 46, "slide": false}, "exit_next_pitch": 47},
