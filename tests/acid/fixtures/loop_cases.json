{
  "format": "ACID-LOOP-ORACLE-1",
  "status": "proposed semantics; not executed against a repeating-cycle interpreter",
  "cursor_policy": "reset_each_time_cycle",
  "entry_mode": "extended",
  "profile_scope": "The cases and boundary_family default to Extended ACID source unless entry_modes lists both modes. These are proposed ACID expectations, not original-hardware traces. Both modes follow Roland: entered leading TIE becomes NOTE; raw leading-TIE source is invalid. entry_cases cover each entry_mode or all listed entry_modes; cutover_cases reject unsupported development data without import or adoption.",
  "cycles": 3,
  "index_base": 1,
  "note_numbering": "Renoise note_value, 0..119",
  "capacity": 64,
  "normalization": "Pad supplied pitches to capacity with valid C defaults; preserve explicit pitch_length. All fixtures start silent. Reset next-consumed PITCH to P01 each TIME cycle; retain voice identity independently.",
  "expectation_order": "Each note_* array follows NOTE commands in TIME order. tie_notes follows TIE commands, null means silent. rest_releases follows REST commands. expected has exactly one record per cycle.",
